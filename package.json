{
  "name": "translation-practice-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --require ./tests/register-typescript.cjs --test \"tests/*.test.cjs\"",
    "test:browser": "node scripts/run-browser-checks.cjs",
    "verify:browser": "node scripts/verify-browser.cjs",
    "test:localization": "node scripts/browser-localization.cjs",
    "test:desktop": "node scripts/desktop-checks.cjs",
    "test:desktop-model": "node scripts/desktop-model-check.cjs",
    "test:android": "node scripts/android-checks.cjs",
    "package:windows": "npm run build && node scripts/prepare-native-assets.cjs windows && electron-builder --win nsis portable --x64",
    "package:android": "npm run build && cap sync android && node scripts/prepare-native-assets.cjs android && node scripts/build-android.cjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.4.3",
    "@capacitor/preferences": "8.0.1",
    "@mlc-ai/web-llm": "0.2.82",
    "idb": "^8.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "playwright-core": "1.64.1",
    "sharp": "0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "com.legendarycookie.lingopractice",
    "productName": "Lingo Practice",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/windows/icon.ico",
      "package.json"
    ],
    "directories": {
      "output": "artifacts/windows"
    },
    "win": {
      "icon": "assets/windows/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Lingo-Practice-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Lingo-Practice-Portable-${version}.${ext}"
    },
    "forceCodeSigning": false
  }
}
